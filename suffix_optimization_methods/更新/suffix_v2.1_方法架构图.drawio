  <diagram id="suffix-v2-1" name="suffix v2.1 方法架构图">
    <mxGraphModel dx="2000" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="suffix v2.1：单阶段多层优化 → 因果连续门控 → 离散候选选择 → 正式结果冻结" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1f4e78;strokeColor=#1f4e78;fontColor=#ffffff;fontStyle=1;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="260" y="20" width="1480" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="band0" value="A. 版本选择与 preflight" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eef4fb;strokeColor=#6c8ebf;fontStyle=1;fontSize=18;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="110" width="1840" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="n1" value="输入 + suffix_version=v2.1&#xa;selected 与 enabled 一致，否则 fail-fast" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="150" y="175" width="310" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="解析 I、目标层 L、层权重 w&#xa;合法词表 V_legal、阈值与 top-k" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="610" y="175" width="310" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="不可变快照与结构检查&#xa;固定/补齐位置永不进入 optimizer" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1070" y="175" width="310" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="仅为 I 中位置创建 trainable embedding&#xa;一次初始化、贯穿全局阶段的 Adam" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1530" y="175" width="310" height="78" as="geometry"/>
        </mxCell>

        <mxCell id="band1" value="B. 单阶段全局连续优化（piecewise surrogate）" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5eff8;strokeColor=#9673a6;fontStyle=1;fontSize=18;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="1840" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="按 refresh_interval 检索并缓存&#xa;V_legal 中每个位置的 top-K_v anchors&#xa;索引与 anchor embedding stop-gradient" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="150" y="395" width="330" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="同一完整序列前向&#xa;提取所有目标层 hidden states" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="580" y="402" width="290" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="L_hidden = Σ_i Σ_l w_l[α_dir D_dir + α_mag D_mag]&#xa;L_vocab = mean_i softmin_topK(q)&#xa;L_global = L_hidden + λ_v L_vocab" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="970" y="385" width="430" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="loss / grad&#xa;全部有限？" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1515" y="385" width="150" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="Adam 更新一次" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1740" y="402" width="130" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="达到全局步数？" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1050" y="520" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="冻结全局连续结果 E_work&#xa;进入严格左到右循环" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1370" y="522" width="270" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="band2" value="C. 位置 i 的因果连续质量门控（只修 e_i，候选结果不回写连续基线）" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf7ed;strokeColor=#82b366;fontStyle=1;fontSize=18;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="650" width="1840" height="340" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="构造 mixed context&#xa;j&lt;i：已提交 token embedding&#xa;j≥i：当前 E_work；未来位置 detach&#xa;每次 fresh forward，不复用 stale KV" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="130" y="730" width="340" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="fresh 计算&#xa;c_i：hidden-only 联合方向/大小误差&#xa;R_i：fresh legal-vocab soft-min&#xa;J_i = c_i + λ_v R_i" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="570" y="730" width="330" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="J_i &gt; τ_J？" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1010" y="735" width="150" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="最多一次 local Adam repair&#xa;仅 e_i 可训练；目标仍为 J_i&#xa;左前缀固定，未来位置 detach" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1270" y="720" width="300" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="d4" value="trial 状态安全且&#xa;J_new &lt; J_old-ε_J&#xa;并且 c_new ≤ c_old+δ_c,max？" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1665" y="705" width="190" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="接受 trial e_i" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1600" y="895" width="150" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="拒绝 trial；恢复旧 e_i&#xa;trial 非有限也只是 local reject" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1765" y="885" width="150" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="fresh 冻结该位置最终 c_i、R_i、J_i&#xa;J_i&gt;τ_J → expanded pool + unresolved_continuous&#xa;否则 normal pool" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="885" width="480" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="band3" value="D. 位置 i 的离散候选评分与一次简化 repair" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff5eb;strokeColor=#d79b00;fontStyle=1;fontSize=18;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="1020" width="1840" height="430" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="建立初始候选并取并集&#xa;normal：K_e,normal embedding 邻居&#xa;+ K_p prefix-only PPL + 当前 token&#xa;expanded：更深 K_e,expanded" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="120" y="1095" width="340" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="统一 legal-vocab 过滤 + 去重&#xa;expanded pool 保留第一轮完整候选与已选 token&#xa;不含 classifier branch" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="550" y="1095" width="350" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="d5" value="候选池非空？" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1000" y="1100" width="150" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="对每个候选做同一 mixed-context fresh forward&#xa;计算 d_i：与 c_i 完全同定义、同层权重&#xa;单候选非有限则丢弃" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1240" y="1085" width="350" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="d6" value="至少一个&#xa;有限正式得分？" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1690" y="1095" width="160" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="按 (d_i, token_id) 稳定排序并选择&#xa;r_i = max(0, d_i-c_i) ∈ [0,1]" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1285" width="310" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="d7" value="r_i &gt; τ_r&#xa;且初始池为 normal？" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="980" y="1270" width="180" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="最多一次 expanded union rerank&#xa;仅当 d_new &lt; d_old-ε_d 才替换&#xa;否则保留原选择；不再递归" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="550" y="1265" width="340" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="提交 token t_i&#xa;记录 unresolved_continuous / unresolved_local_degradation&#xa;候选选择不修改 E_work[i]" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="1280" width="340" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="band4" value="E. 正式结果冻结与离线诊断隔离" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=18;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="1480" width="1840" height="285" as="geometry"/>
        </mxCell>
        <mxCell id="d8" value="还有未处理位置？" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="220" y="1555" width="180" height="110" as="geometry"/>
        </mxCell>
