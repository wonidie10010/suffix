<mxfile host="Electron">
  <diagram id="checkpoint-segment-v1" name="检查点诊断：段级审查与单点修复">
    <mxGraphModel dx="2059" dy="1183" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1520" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#1f2937;" value="&lt;b&gt;部件图：检查点诊断&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;每 5 个已提交 token 做段级审查；只定位一处、只修复一次｜设计完成 · 尚未实现 / 验证&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="1480" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="segment" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#1f2937;spacing=10;" value="&lt;b&gt;完成 5 个 token 的位置处理&lt;/b&gt;&lt;br&gt;各位置 R 处理结束后计数&lt;br&gt;固定前缀之后，严格不重叠" vertex="1">
          <mxGeometry height="110" width="280" x="40" y="180" as="geometry" />
        </mxCell>
        <mxCell id="sum" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#1f2937;spacing=10;" value="&lt;b&gt;观察当前离散段&lt;/b&gt;&lt;br&gt;当前与目标各自累加 5 个 hidden&lt;br&gt;计算两组和向量的 cosine：C" vertex="1">
          <mxGeometry height="110" width="280" x="400" y="180" as="geometry" />
        </mxCell>
        <mxCell id="trigger" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#1f2937;spacing=10;" value="&lt;b&gt;C &amp;lt; 0.90？&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="230" x="760" y="160" as="geometry" />
        </mxCell>
        <mxCell id="trajectory" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#1f2937;spacing=10;" value="&lt;b&gt;展开段内累计轨迹&lt;/b&gt;&lt;br&gt;第 1 点 → 前 2 点 → … → 全 5 点&lt;br&gt;看加入哪一点后 cosine 明显下降" vertex="1">
          <mxGeometry height="130" width="360" x="1080" y="170" as="geometry" />
        </mxCell>
        <mxCell id="classify" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#1f2937;spacing=10;" value="&lt;b&gt;区分两类下降&lt;/b&gt;&lt;br&gt;孤立异常：后续 1–2 点基本恢复&lt;br&gt;累计恶化：下降后到段末持续未恢复&lt;br&gt;&lt;br&gt;“基本恢复”的容忍量需预先设定" vertex="1">
          <mxGeometry height="170" width="360" x="1080" y="390" as="geometry" />
        </mxCell>
        <mxCell id="locate" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#1f2937;spacing=10;" value="&lt;b&gt;只定位一个位置 p&lt;/b&gt;&lt;br&gt;优先最早持续未恢复下降点&lt;br&gt;仅有孤立异常时，取最大下降点" vertex="1">
          <mxGeometry height="110" width="360" x="1080" y="660" as="geometry" />
        </mxCell>
        <mxCell id="pool" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#1f2937;spacing=10;" value="&lt;b&gt;复用 p 的有效原候选表&lt;/b&gt;&lt;br&gt;按合法性与单点质量下限筛选&lt;br&gt;无新候选源；不放宽阈值" vertex="1">
          <mxGeometry height="110" width="280" x="710" y="660" as="geometry" />
        </mxCell>
        <mxCell id="forward" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#1f2937;spacing=10;" value="&lt;b&gt;每个合格候选重新前向&lt;/b&gt;&lt;br&gt;只替换 p，其他 token ID 固定&lt;br&gt;复用 p 前上下文，重算 p 至段末&lt;br&gt;重新计算整个 5-token 段的 C" vertex="1">
          <mxGeometry height="150" width="280" x="360" y="640" as="geometry" />
        </mxCell>
        <mxCell id="best" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#1f2937;spacing=10;" value="&lt;b&gt;选段级 C 最大者&lt;/b&gt;&lt;br&gt;所有候选基于同一个旧段&lt;br&gt;保留原结果作为比较基准" vertex="1">
          <mxGeometry height="110" width="240" x="40" y="660" as="geometry" />
        </mxCell>
        <mxCell id="accept" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1f2937;spacing=10;" value="&lt;b&gt;最佳有效 C&lt;br&gt;严格优于原 C？&lt;/b&gt;" vertex="1">
          <mxGeometry height="140" width="210" x="60" y="880" as="geometry" />
        </mxCell>
        <mxCell id="commit" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#1f2937;spacing=10;" value="&lt;b&gt;提交唯一 token 替换&lt;/b&gt;&lt;br&gt;更新已提交前缀&lt;br&gt;使旧下游上下文失效" vertex="1">
          <mxGeometry height="100" width="280" x="390" y="890" as="geometry" />
        </mxCell>
        <mxCell id="keep" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#1f2937;spacing=10;" value="&lt;b&gt;保留原 token 与上下文&lt;/b&gt;&lt;br&gt;没有合格候选 / 没有改善 / 试算失败" vertex="1">
          <mxGeometry height="90" width="350" x="40" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="finish" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#1f2937;spacing=10;" value="&lt;b&gt;结束当前 checkpoint&lt;/b&gt;&lt;br&gt;即使 C 仍低于 0.90，也不再修复&lt;br&gt;按最终前缀继续下一段恢复&lt;br&gt;不足 5 个 token 的尾段直接完成" vertex="1">
          <mxGeometry height="150" width="360" x="1080" y="880" as="geometry" />
        </mxCell>
        <mxCell id="notes" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#1f2937;spacing=10;dashed=1;align=left;spacingLeft=18;" value="&lt;b&gt;输入与判断边界&lt;/b&gt;&lt;br&gt;两边使用同模型、同目标层、同位置的 hidden；当前侧来自离散 token 前向。&lt;br&gt;只使用 target hidden，不使用 GT token、accuracy 或 oracle correctness。&lt;br&gt;持续低分但无明显下降、段末没有后效证据等情况，可触发而不定位。&lt;br&gt;&lt;b&gt;工程缺口：&lt;/b&gt;live v2.2.1 没有候选质量下限；需显式配置，不能借用触发阈值。" vertex="1">
          <mxGeometry height="190" width="950" x="40" y="370" as="geometry" />
        </mxCell>
        <mxCell id="e_segment_sum" edge="1" parent="1" source="segment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="sum" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_sum_trigger" edge="1" parent="1" source="sum" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="trigger" value="">
          <mxGeometry relative="1" as="geometry" />
