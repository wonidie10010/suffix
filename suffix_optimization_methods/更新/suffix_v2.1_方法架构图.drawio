          <mxGeometry x="540" y="1565" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="冻结 formal tokens&#xa;冻结 token-consistent embedding = embedding(final_tokens)&#xa;E_work 仅保留内部诊断语义" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
