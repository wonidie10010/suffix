        <mxCell id="n24" value="diagnostics_enabled？&#xa;否：零 ground-truth read&#xa;是：正式结果冻结后只读诊断" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1410" y="1550" width="300" height="115" as="geometry"/>
