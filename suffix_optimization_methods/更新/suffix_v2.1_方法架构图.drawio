        <mxCell id="n25" value="返回正式结果&#xa;诊断异常仅 diagnostics_failed&#xa;不得回滚或改写 formal result" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1f4e78;strokeColor=#1f4e78;fontColor=#ffffff;fontSize=15;fontStyle=1;" vertex="1" parent="1">
